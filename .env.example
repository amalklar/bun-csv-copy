# Required. URL-encode special characters in the username and password.
DB_URL=postgresql://USER:PASSWORD@HOST:5432/user_account_database?sslmode=verify-full
CSV_PATH=/absolute/path/users.csv

# UAS is the default. Use generic for other PostgreSQL tables.
IMPORT_PROFILE=uas
DB_NAME=user_account_database
DB_SCHEMA=public
DB_TABLE=account_family_backfill_tasks
CSV_COLUMNS=user_id,product_category_combination,credit_line_family
CSV_DELIMITER=,

# Optional CA file. Setting this requires TLS certificate and hostname verification.
DB_SSL_ROOT_CERT=
